# Dependencies
node_modules/
client/node_modules/
server/node_modules/

# Production build (will be built during deployment)
client/dist/

# Environment variables
.env
.env.local
.env.*.local

# Database files (keep schema & seeds in code, not binary sqlite)
server/data/*.sqlite
server/data/*.sqlite-journal
server/data/*.sqlite-wal
server/data/*.sqlite-shm
!server/data/.gitkeep

# Local user uploads
server/uploads/*
!server/uploads/.gitkeep

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Editor & OS files
.DS_Store
Thumbs.db
.vscode/
.idea/
